# Copy this file to .env and fill in your keys.
# NEVER commit .env to the repository.

# Required for Anthropic tasks
ANTHROPIC_API_KEY=

# Optional — only needed if you use these providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Server config (optional — defaults shown)
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Storage (optional — defaults to ./data)
DATA_DIR=./data
